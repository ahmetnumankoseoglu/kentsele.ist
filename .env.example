# Kopyala: cp .env.example .env.local  (Windows: copy .env.example .env.local)

# Schema / canonical / sitemap — her zaman canlı domain (localhost yazma)
NEXT_PUBLIC_SITE_URL=https://kentsele.ist

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin paneli /yonetim
ADMIN_PASSWORD=degistir-bu-sifreyi
ADMIN_SESSION_SECRET=en-az-32-karakter-rastgele-string

# Resend (https://resend.com/api-keys) — re_xxxxxxxxx yerine kendi key'in
RESEND_API_KEY=re_xxxxxxxxx
# Resend'de kentsele.ist domaini doğrulanmış olmalı
EMAIL_FROM=Kentsele.ist <noreply@kentsele.ist>
# Yeni ilan / iletişim formu admin bildirimi
ADMIN_NOTIFY_EMAIL=ankv666@gmail.com
